<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- AudioRecord capture over the mic: Module 3 acoustic modem "listen" (task #7),
         Module 5 detector passive listening (task #10). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nightjar"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="uiMode"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- v6 receive plumbing (spec.md gate-31, INV-10): no scheme is declared on either
                 data element below, so Android's IntentFilter matcher implicitly accepts
                 content:// and file:// Uris for a filter that names a MIME type but no scheme,
                 which is exactly this app's real inputs (a share sheet's EXTRA_STREAM, an open
                 with chooser's content Uri) and needs no permission to receive (INV-10: no
                 INTERNET, no broad storage read). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

    </application>

</manifest>
